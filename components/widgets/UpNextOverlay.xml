<?xml version="1.0" encoding="utf-8"?>
<!--
    UpNextOverlay — "Up next: Part 2 of 3 · Starting in 10s" card.

    Set heading/title, make it visible, focus it, then set start = true.
    When the countdown ends or the user presses OK, choice = "play".
    Back sets choice = "cancel".
-->
<component name="UpNextOverlay" extends="Group">
    <interface>
        <field id="heading" type="string" alias="headingLabel.text" />
        <field id="title" type="string" alias="titleLabel.text" />
        <field id="seconds" type="integer" value="10" />
        <field id="start" type="boolean" alwaysNotify="true" onChange="onStart" />
        <field id="choice" type="string" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="UpNextOverlay.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x000000A0" />
        <Group translation="[1100, 700]">
            <Rectangle width="680" height="260" color="0x1E252DF0" />
            <Rectangle width="8" height="260" color="0x3D7EFFFF" />
            <Label id="headingLabel" translation="[40, 30]" color="0x8A96A3FF">
                <Font role="font" uri="font:SystemFontFile" size="30" />
            </Label>
            <Label id="titleLabel" translation="[40, 75]" width="600">
                <Font role="font" uri="font:BoldSystemFontFile" size="44" />
            </Label>
            <Label id="countdownLabel" translation="[40, 150]" width="600" color="0xC8D0D8FF">
                <Font role="font" uri="font:SystemFontFile" size="30" />
            </Label>
            <Label translation="[40, 195]" width="600" color="0x8A96A3FF" text="OK  play now     Back  stop">
                <Font role="font" uri="font:SystemFontFile" size="26" />
            </Label>
        </Group>
        <Timer id="timer" duration="1" repeat="true" />
    </children>
</component>
