<?xml version="1.0" encoding="utf-8"?>
<!--
    UpNextOverlay — "Up next: S02E06 · Starting in 7 s" card, shown by
    PlayerScreen during the last 10 seconds of an episode or movie part.

    It only displays; PlayerScreen keeps the remote (OK on the card plays the
    next item now, Pause still pauses) and sets "seconds" as playback moves.
-->
<component name="UpNextOverlay" extends="Group">
    <interface>
        <field id="heading" type="string" alias="headingLabel.text" />
        <field id="title" type="string" alias="titleLabel.text" />
        <field id="seconds" type="integer" onChange="onSecondsChange" />
    </interface>

    <script type="text/brightscript" uri="UpNextOverlay.brs" />

    <children>
        <!-- Bottom-right, above the player controls' darkened band. -->
        <Group translation="[1180, 500]">
            <Rectangle width="640" height="210" color="0x1E252DF0" />
            <Rectangle width="8" height="210" color="0x3D7EFFFF" />
            <Label id="headingLabel" translation="[36, 24]" color="0x8A96A3FF">
                <Font role="font" uri="font:SystemFontFile" size="28" />
            </Label>
            <Label id="titleLabel" translation="[36, 62]" width="580">
                <Font role="font" uri="font:BoldSystemFontFile" size="40" />
            </Label>
            <Label id="countdownLabel" translation="[36, 125]" width="580" color="0xC8D0D8FF">
                <Font role="font" uri="font:SystemFontFile" size="28" />
            </Label>
            <Label translation="[36, 165]" width="580" color="0x8A96A3FF" text="OK  Play now">
                <Font role="font" uri="font:SystemFontFile" size="24" />
            </Label>
        </Group>
    </children>
</component>
