<?xml version="1.0" encoding="utf-8"?>
<!--
    SlideshowScreen — plays every photo and video in a folder, oldest first.

    Fields:
      title – folder name (shown in the info bar)
      paths – the folder(s) (several when the same folder is on two drives)

    Two image "slots" take turns: while one is on screen, the next photo
    loads into the hidden one, so changing photos never flashes black.
    Each slot is:
      slot  (Group, clipped to the screen; moved / scaled / faded)
        inner (Group; moved the opposite way for the wipe effect)
          poster (rotated for EXIF orientation)
    The "transition" Animation animates both slots; lib/Transitions.brs
    decides the start/end values.
-->
<component name="SlideshowScreen" extends="BaseScreen">
    <interface>
        <field id="title" type="string" />
        <field id="paths" type="array" />
    </interface>

    <script type="text/brightscript" uri="SlideshowScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Settings.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Transitions.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/MediaTypes.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />

        <Group id="stage">
            <Group id="slotA" visible="false" clippingRect="[0, 0, 1920, 1080]" scaleRotateCenter="[960, 540]">
                <Group id="innerA">
                    <Poster id="posterA" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToFit" />
                </Group>
            </Group>
            <Group id="slotB" visible="false" clippingRect="[0, 0, 1920, 1080]" scaleRotateCenter="[960, 540]">
                <Group id="innerB">
                    <Poster id="posterB" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToFit" />
                </Group>
            </Group>
        </Group>

        <!-- One interpolator per animated field; keyValues are set per
             transition in SlideshowScreen.brs. -->
        <Animation id="transition" duration="0.8" easeFunction="inOutCubic" repeat="false">
            <FloatFieldInterpolator id="aOpacity" fieldToInterp="slotA.opacity" key="[0.0, 1.0]" />
            <Vector2DFieldInterpolator id="aTranslation" fieldToInterp="slotA.translation" key="[0.0, 1.0]" />
            <Vector2DFieldInterpolator id="aScale" fieldToInterp="slotA.scale" key="[0.0, 1.0]" />
            <Vector2DFieldInterpolator id="aInner" fieldToInterp="innerA.translation" key="[0.0, 1.0]" />
            <FloatFieldInterpolator id="bOpacity" fieldToInterp="slotB.opacity" key="[0.0, 1.0]" />
            <Vector2DFieldInterpolator id="bTranslation" fieldToInterp="slotB.translation" key="[0.0, 1.0]" />
            <Vector2DFieldInterpolator id="bScale" fieldToInterp="slotB.scale" key="[0.0, 1.0]" />
            <Vector2DFieldInterpolator id="bInner" fieldToInterp="innerB.translation" key="[0.0, 1.0]" />
        </Animation>

        <Video id="video" width="1920" height="1080" enableUI="false" visible="false" />

        <!-- Date, name and position; shown for a few seconds on key presses. -->
        <Group id="info" visible="false">
            <Rectangle translation="[0, 860]" width="1920" height="220" color="0x000000A0" />
            <Label id="dateLabel" translation="[96, 900]" width="1300">
                <Font role="font" uri="font:BoldSystemFontFile" size="44" />
            </Label>
            <Label id="nameLabel" translation="[96, 965]" width="1300" color="0xC8D0D8FF">
                <Font role="font" uri="font:SystemFontFile" size="30" />
            </Label>
            <Label id="counterLabel" translation="[1424, 910]" width="400" horizAlign="right" color="0xC8D0D8FF">
                <Font role="font" uri="font:SystemFontFile" size="32" />
            </Label>
        </Group>

        <Group id="pauseIcon" translation="[904, 484]" visible="false">
            <Poster uri="pkg:/images/btn_focus.png" width="112" height="112" />
            <Poster uri="pkg:/images/ic_pause.png" translation="[24, 24]" width="64" height="64" />
        </Group>

        <LoadingOverlay id="loading" visible="false" />

        <Timer id="photoTimer" repeat="false" />
        <Timer id="infoTimer" duration="4" repeat="false" />
    </children>
</component>
