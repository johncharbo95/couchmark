<?xml version="1.0" encoding="utf-8"?>
<!--
    HomeScreen — Movies / Shows / Other / Settings tiles.
-->
<component name="HomeScreen" extends="BaseScreen">
    <script type="text/brightscript" uri="HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Text.brs" />

    <children>
        <Label id="appTitle" text="Couchmark" translation="[155, 120]" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="72" />
        </Label>

        <!-- A grid of 4 tiles in one row. Each tile is drawn by HomeTile. -->
        <MarkupGrid
            id="grid"
            translation="[155, 340]"
            itemComponentName="HomeTile"
            itemSize="[380, 380]"
            itemSpacing="[30, 0]"
            numColumns="4"
            numRows="1"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="fixedFocus" />

        <Label id="status" translation="[155, 900]" width="1610" wrap="true" color="0x8A96A3FF">
            <Font role="font" uri="font:SystemFontFile" size="30" />
        </Label>
    </children>
</component>
