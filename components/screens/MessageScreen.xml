<?xml version="1.0" encoding="utf-8"?>
<!--
    MessageScreen — a full-screen title + explanation.
    Used for "no USB drive", "missing folder" and placeholder messages.
-->
<component name="MessageScreen" extends="BaseScreen">
    <interface>
        <field id="title" type="string" alias="titleLabel.text" />
        <field id="message" type="string" alias="messageLabel.text" />
        <!-- When true, OK asks MainScene to rescan the USB drives. -->
        <field id="allowRescan" type="boolean" value="false" onChange="updateHint" />
    </interface>

    <script type="text/brightscript" uri="MessageScreen.brs" />

    <children>
        <Label id="titleLabel" translation="[160, 160]" width="1600" wrap="true">
            <Font role="font" uri="font:BoldSystemFontFile" size="64" />
        </Label>
        <Label id="messageLabel" translation="[160, 300]" width="1600" wrap="true" lineSpacing="10" color="0xC8D0D8FF">
            <Font role="font" uri="font:SystemFontFile" size="36" />
        </Label>
        <Label id="hintLabel" translation="[160, 940]" width="1600" color="0x8A96A3FF">
            <Font role="font" uri="font:SystemFontFile" size="30" />
        </Label>
    </children>
</component>
