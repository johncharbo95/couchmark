<?xml version="1.0" encoding="utf-8"?>
<!--
    MovieScreen — a movie's page: artwork, title, and
    "Resume" + "Play from beginning" (or just "Play").

    Fields:
      title – movie folder name (also the key for saved progress)
      path  – the movie folder
      art   – artwork path or ""
-->
<component name="MovieScreen" extends="BaseScreen">
    <interface>
        <field id="title" type="string" alias="titleLabel.text" />
        <field id="path" type="string" />
        <field id="art" type="string" alias="heroArt.uri" />
    </interface>

    <script type="text/brightscript" uri="MovieScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Progress.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Library.brs" />

    <children>
        <Poster id="heroArt" translation="[700, 0]" width="1220" height="686" loadWidth="1220" loadHeight="686" loadDisplayMode="scaleToZoom" opacity="0.7" />
        <Poster uri="pkg:/images/fade.png" translation="[700, 0]" width="1220" height="686" />

        <Label id="titleLabel" translation="[96, 160]" width="1100" wrap="true" maxLines="2">
            <Font role="font" uri="font:BoldSystemFontFile" size="72" />
        </Label>
        <Label id="infoLabel" translation="[96, 360]" width="1100" color="0xC8D0D8FF">
            <Font role="font" uri="font:SystemFontFile" size="34" />
        </Label>
        <Group id="progressBar" translation="[96, 420]" visible="false">
            <Rectangle width="500" height="8" color="0x3A4552FF" />
            <Rectangle id="progressFill" width="0" height="8" color="0x3D7EFFFF" />
        </Group>

        <LabelList
            id="buttons"
            translation="[96, 480]"
            itemSize="[620, 84]"
            itemSpacing="[0, 12]"
            color="0xC8D0D8FF"
            focusedColor="0x101418FF"
            focusBitmapBlendColor="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="36" />
            <Font role="focusedFont" uri="font:BoldSystemFontFile" size="36" />
        </LabelList>

        <LoadingOverlay id="loading" visible="false" />
    </children>
</component>
