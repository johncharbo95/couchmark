<?xml version="1.0" encoding="utf-8"?>
<!--
    FolderListScreen — a scrolling list of folders, used for browsing.

    Fields (set by whoever opens the screen):
      title – heading, e.g. "Movies"
      kind  – what the list contains; decides what OK does:
              "movies": each entry is a movie folder (play / resume it)
      paths – folders to list (several when merging drives)
-->
<component name="FolderListScreen" extends="BaseScreen">
    <interface>
        <field id="title" type="string" alias="titleLabel.text" />
        <field id="kind" type="string" />
        <field id="paths" type="array" />
    </interface>

    <script type="text/brightscript" uri="FolderListScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Progress.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Format.brs" />

    <children>
        <Label id="titleLabel" translation="[155, 90]" width="1200">
            <Font role="font" uri="font:BoldSystemFontFile" size="60" />
        </Label>
        <Label id="countLabel" translation="[1365, 110]" width="400" horizAlign="right" color="0x8A96A3FF">
            <Font role="font" uri="font:SystemFontFile" size="30" />
        </Label>

        <MarkupList
            id="list"
            translation="[155, 210]"
            itemComponentName="ListItem"
            itemSize="[1610, 84]"
            itemSpacing="[0, 8]"
            numRows="8"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="floatingFocus" />

        <Label id="emptyLabel" translation="[155, 240]" width="1610" wrap="true" visible="false" color="0xC8D0D8FF">
            <Font role="font" uri="font:SystemFontFile" size="36" />
        </Label>

        <LoadingOverlay id="loading" visible="false" />
    </children>
</component>
